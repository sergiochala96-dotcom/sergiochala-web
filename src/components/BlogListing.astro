---
import { getCollection, type CollectionEntry } from 'astro:content';
import { upcomingTopics, type UpcomingTopic } from '../data/upcomingTopics';

interface Props {
  heading: string;
  posts: CollectionEntry<'blog'>[];
  activePillar?: 'hotmart' | 'skool' | 'claude';
}

const { heading, posts, activePillar } = Astro.props;

const pillarLabels: Record<string, string> = {
  hotmart: 'Hotmart',
  skool: 'Skool',
  claude: 'Claude',
};

const allPublished = await getCollection('blog', ({ data }) => !data.draft);
const counts = {
  total: allPublished.length,
  hotmart: allPublished.filter((p) => p.data.pillar === 'hotmart').length,
  skool: allPublished.filter((p) => p.data.pillar === 'skool').length,
  claude: allPublished.filter((p) => p.data.pillar === 'claude').length,
};

const featured = posts[0];
const restPosts = posts.slice(1);

const placeholders = activePillar
  ? upcomingTopics.filter((topic) => topic.pillar === activePillar)
  : upcomingTopics;

type Item =
  | { kind: 'post'; post: CollectionEntry<'blog'> }
  | { kind: 'placeholder'; topic: UpcomingTopic };

const otherItems: Item[] = [
  ...restPosts.map((post): Item => ({ kind: 'post', post })),
  ...placeholders.map((topic): Item => ({ kind: 'placeholder', topic })),
];

const allItems: Item[] = [
  ...posts.map((post): Item => ({ kind: 'post', post })),
  ...placeholders.map((topic): Item => ({ kind: 'placeholder', topic })),
];
const ALL_GRID_FOLD = 9;

// Todavía no tenemos analítica de lecturas, así que "más leídos" usa el
// artículo más reciente como destacado y los siguientes como lista corta.
// El resto cae en "Más recientes". Si no hay ningún artículo real todavía
// (pilar sin publicar nada aún), no mostramos "más leídos" y todo va a
// "Más recientes".
const sideItems = featured ? otherItems.slice(0, 3) : [];
const recentItems = featured ? otherItems.slice(3) : otherItems;

const dateFmt = (d: Date) =>
  d.toLocaleDateString('es', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<h1 class="blog-page-title">{heading}</h1>

<div class="blog-search-row">
  <label class="blog-search">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <input type="search" id="blog-search-input" placeholder="Busca un artículo..." />
  </label>
</div>

<nav class="blog-categories">
  <a href="/blog/" class={!activePillar ? 'active' : ''}>Todo ({counts.total})</a>
  <a href="/blog/skool/" class={activePillar === 'skool' ? 'active' : ''}>Skool ({counts.skool})</a>
  <a href="/blog/hotmart/" class={activePillar === 'hotmart' ? 'active' : ''}>Hotmart ({counts.hotmart})</a>
  <a href="/blog/claude/" class={activePillar === 'claude' ? 'active' : ''}>Claude ({counts.claude})</a>
</nav>

{posts.length === 0 && placeholders.length === 0 && (
  <p class="empty-state">Todavía no hay artículos publicados. Pronto empezamos.</p>
)}

<div id="blog-search-scope">
  {featured && (
    <section class="most-read">
      <h2 class="section-label">Blogs más leídos</h2>
      <div class="most-read-grid">
        <a class="blog-featured" href={`/blog/${featured.id}/`}>
          <div class="blog-featured-media" data-pillar={featured.data.pillar}>
            {featured.data.coverImage ? (
              <img src={featured.data.coverImage} alt={featured.data.title} width="760" height="475" />
            ) : (
              <span>{pillarLabels[featured.data.pillar]}</span>
            )}
          </div>
          <div class="blog-featured-copy">
            <p class="blog-featured-meta">
              {dateFmt(featured.data.pubDate)} · <span class="pillar-tag">{pillarLabels[featured.data.pillar]}</span>
            </p>
            <h2>{featured.data.title}</h2>
            <p class="blog-featured-desc">{featured.data.description}</p>
          </div>
        </a>

        {sideItems.length > 0 && (
          <div class="most-read-list">
            {sideItems.map((item) =>
              item.kind === 'post' ? (
                <a
                  class="most-read-item"
                  href={`/blog/${item.post.id}/`}
                  data-search={`${item.post.data.title} ${item.post.data.description}`.toLowerCase()}
                >
                  <div class="most-read-item-media" data-pillar={item.post.data.pillar}>
                    {item.post.data.coverImage && (
                      <img src={item.post.data.coverImage} alt={item.post.data.title} width="140" height="88" />
                    )}
                  </div>
                  <div class="most-read-item-body">
                    <p class="post-meta">
                      {dateFmt(item.post.data.pubDate)} · <span class="pillar-tag">{pillarLabels[item.post.data.pillar]}</span>
                    </p>
                    <h3>{item.post.data.title}</h3>
                  </div>
                </a>
              ) : (
                <div class="most-read-item most-read-item--placeholder" data-search={item.topic.title.toLowerCase()}>
                  <div class="most-read-item-media" data-pillar={item.topic.pillar} />
                  <div class="most-read-item-body">
                    <p class="post-meta">
                      <span class="badge-soon">Próximamente</span>
                    </p>
                    <h3>{item.topic.title}</h3>
                  </div>
                </div>
              )
            )}
          </div>
        )}
      </div>
    </section>
  )}

  {recentItems.length > 0 && (
    <section class="recent-section">
      <h2 class="section-label">Más recientes</h2>
      <div class="blog-grid" id="blog-grid">
        {recentItems.map((item) =>
          item.kind === 'post' ? (
            <a
              class="blog-card"
              href={`/blog/${item.post.id}/`}
              data-search={`${item.post.data.title} ${item.post.data.description}`.toLowerCase()}
            >
              <div class="blog-card-media" data-pillar={item.post.data.pillar}>
                {item.post.data.coverImage ? (
                  <img src={item.post.data.coverImage} alt={item.post.data.title} width="400" height="250" />
                ) : (
                  <span>{pillarLabels[item.post.data.pillar]}</span>
                )}
              </div>
              <p class="post-meta">
                {dateFmt(item.post.data.pubDate)} · <span class="pillar-tag">{pillarLabels[item.post.data.pillar]}</span>
              </p>
              <h3>{item.post.data.title}</h3>
              <p>{item.post.data.description}</p>
            </a>
          ) : (
            <div class="blog-card blog-card--placeholder" data-search={item.topic.title.toLowerCase()}>
              <div class="blog-card-media" data-pillar={item.topic.pillar}>
                <span>{pillarLabels[item.topic.pillar]}</span>
              </div>
              <p class="post-meta">
                <span class="badge-soon">Próximamente</span>
              </p>
              <h3>{item.topic.title}</h3>
              <p>Todavía estoy escribiendo este artículo.</p>
            </div>
          )
        )}
      </div>
    </section>
  )}

  {allItems.length > 0 && (
    <section class="all-blogs-section">
      <h2 class="section-label">Todos los blogs ({allItems.length})</h2>
      <div class="blog-grid" id="blog-grid-all">
        {allItems.map((item, index) =>
          item.kind === 'post' ? (
            <a
              class={`blog-card ${index >= ALL_GRID_FOLD ? 'is-extra' : ''}`}
              href={`/blog/${item.post.id}/`}
              data-search={`${item.post.data.title} ${item.post.data.description}`.toLowerCase()}
            >
              <div class="blog-card-media" data-pillar={item.post.data.pillar}>
                {item.post.data.coverImage ? (
                  <img src={item.post.data.coverImage} alt={item.post.data.title} width="400" height="250" />
                ) : (
                  <span>{pillarLabels[item.post.data.pillar]}</span>
                )}
              </div>
              <p class="post-meta">
                {dateFmt(item.post.data.pubDate)} · <span class="pillar-tag">{pillarLabels[item.post.data.pillar]}</span>
              </p>
              <h3>{item.post.data.title}</h3>
              <p>{item.post.data.description}</p>
            </a>
          ) : (
            <div
              class={`blog-card blog-card--placeholder ${index >= ALL_GRID_FOLD ? 'is-extra' : ''}`}
              data-search={item.topic.title.toLowerCase()}
            >
              <div class="blog-card-media" data-pillar={item.topic.pillar}>
                <span>{pillarLabels[item.topic.pillar]}</span>
              </div>
              <p class="post-meta">
                <span class="badge-soon">Próximamente</span>
              </p>
              <h3>{item.topic.title}</h3>
              <p>Todavía estoy escribiendo este artículo.</p>
            </div>
          )
        )}
      </div>

      {allItems.length > ALL_GRID_FOLD && (
        <div class="blog-show-all">
          <button type="button" class="cta" id="blog-show-all-btn">
            Ver todos los blogs ({allItems.length})
          </button>
        </div>
      )}
    </section>
  )}

  <p class="blog-search-empty" id="blog-search-empty" hidden>No encontré artículos con ese término.</p>
</div>

<script>
  const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
  const scope = document.getElementById('blog-search-scope');
  const emptyMsg = document.getElementById('blog-search-empty');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    const cards = scope?.querySelectorAll<HTMLElement>('[data-search]') ?? [];
    let visible = 0;

    cards.forEach((card) => {
      const match = card.dataset.search?.includes(query) ?? true;
      card.hidden = !match;
      if (match) visible += 1;
    });

    if (emptyMsg) emptyMsg.hidden = visible !== 0 || query === '';
  });

  const showAllBtn = document.getElementById('blog-show-all-btn');
  const allGrid = document.getElementById('blog-grid-all');

  showAllBtn?.addEventListener('click', () => {
    allGrid?.classList.add('is-expanded');
    showAllBtn.hidden = true;
  });
</script>
