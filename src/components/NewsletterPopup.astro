---
---
<div class="newsletter-popup" id="newsletter-popup" role="dialog" aria-modal="true" aria-labelledby="newsletter-popup-title" hidden>
  <div class="newsletter-popup-backdrop" id="newsletter-popup-backdrop"></div>
  <div class="newsletter-popup-card">
    <button type="button" class="newsletter-popup-close" id="newsletter-popup-close" aria-label="Cerrar">&times;</button>

    <div class="newsletter-popup-media">
      <img class="newsletter-popup-img-desktop" src="/images/sergio-popup-festival.png" alt="Sergio Chala" width="1254" height="1254" />
      <img class="newsletter-popup-img-mobile" src="/images/sergio-popup-festival-wide.png" alt="Sergio Chala" width="681" height="311" />
    </div>

    <div class="newsletter-popup-body">
      <p class="newsletter-popup-eyebrow">Únete gratis</p>
      <h2 id="newsletter-popup-title">No te pierdas nada de <span class="highlight">Skool, Hotmart y Claude</span></h2>
      <p class="newsletter-popup-text">Te aviso cuando publique un artículo nuevo. Sin spam.</p>

      <form method="post" action="https://systeme.io/embedded/46220649/subscription" target="newsletter-popup-frame" class="newsletter-popup-form" id="newsletter-popup-form">
        <label>
          Nombre
          <input type="text" name="surname" placeholder="Tu nombre" required />
        </label>
        <label>
          Email
          <input type="email" name="email" placeholder="tu@email.com" required />
        </label>
        <div class="f-row">
          <button type="submit" class="cta cta-glass cta-pulse-glass btn">Quiero suscribirme</button>
        </div>
      </form>

      <div class="newsletter-popup-success" id="newsletter-popup-success" hidden>
        <p>¡Listo! Ya estás suscrito. Te aviso cuando publique un artículo nuevo.</p>
      </div>
    </div>
  </div>

  <iframe name="newsletter-popup-frame" class="newsletter-popup-frame" aria-hidden="true" tabindex="-1"></iframe>
</div>

<script>
  const popup = document.getElementById('newsletter-popup');
  const closeBtn = document.getElementById('newsletter-popup-close');
  const backdrop = document.getElementById('newsletter-popup-backdrop');
  const form = document.getElementById('newsletter-popup-form');
  const successMsg = document.getElementById('newsletter-popup-success');
  const SUBSCRIBED_KEY = 'sc-newsletter-subscribed';

  function closePopup() {
    popup?.setAttribute('hidden', '');
  }

  function isAlreadySubscribed() {
    try {
      return localStorage.getItem(SUBSCRIBED_KEY) === '1';
    } catch (_) {
      return false;
    }
  }

  form?.addEventListener('submit', () => {
    // El form se envía a un iframe oculto (target="newsletter-popup-frame")
    // para no sacar a la persona de la página con la pantalla de Systeme.io.
    form.hidden = true;
    if (successMsg) successMsg.hidden = false;
    try {
      localStorage.setItem(SUBSCRIBED_KEY, '1');
    } catch (_) {
      /* private mode or storage blocked: ignore */
    }
    setTimeout(closePopup, 3000);
  });

  if (popup && !isAlreadySubscribed()) {
    setTimeout(() => {
      popup.removeAttribute('hidden');
    }, 20000);
  }

  closeBtn?.addEventListener('click', closePopup);
  backdrop?.addEventListener('click', closePopup);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closePopup();
  });
</script>
