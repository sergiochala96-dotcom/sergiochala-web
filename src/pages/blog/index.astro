---
import Layout from '../../layouts/Layout.astro';
import BlogListing from '../../components/BlogListing.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="Blog" description="Artículos de Sergio Chala sobre Skool, Hotmart y Claude.">
  <BlogListing
    heading="Blog"
    intro="Artículos basados en experiencia real usando Skool, Hotmart y Claude."
    posts={posts}
  />
</Layout>
