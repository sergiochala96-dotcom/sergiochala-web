---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pillars = ['hotmart', 'skool', 'claude'] as const;
  return pillars.map((pilar) => ({ params: { pilar } }));
}

const { pilar } = Astro.params;

const pillarLabels: Record<string, string> = {
  hotmart: 'Hotmart',
  skool: 'Skool',
  claude: 'Claude',
};

const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.pillar === pilar);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const label = pillarLabels[pilar as string] ?? pilar;
---
<Layout title={`Blog · ${label}`} description={`Artículos de Sergio Chala sobre ${label}.`}>
  <h1>Blog · {label}</h1>

  <nav class="filters">
    <a href="/blog/">Todos</a>
    <a href="/blog/hotmart/" class={pilar === 'hotmart' ? 'active' : ''}>Hotmart</a>
    <a href="/blog/skool/" class={pilar === 'skool' ? 'active' : ''}>Skool</a>
    <a href="/blog/claude/" class={pilar === 'claude' ? 'active' : ''}>Claude</a>
  </nav>

  {posts.length === 0 && (
    <p class="empty-state">Todavía no hay artículos de {label}. Pronto empezamos.</p>
  )}

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        <p class="post-meta">
          {post.data.pubDate.toLocaleDateString('es', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>
