---
import Layout from '../../../layouts/Layout.astro';
import BlogListing from '../../../components/BlogListing.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pillars = ['hotmart', 'skool', 'claude'] as const;
  return pillars.map((pilar) => ({ params: { pilar } }));
}

const { pilar } = Astro.params as { pilar: 'hotmart' | 'skool' | 'claude' };

const pillarLabels: Record<string, string> = {
  hotmart: 'Hotmart',
  skool: 'Skool',
  claude: 'Claude',
};

const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.pillar === pilar);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const label = pillarLabels[pilar] ?? pilar;
---
<Layout title={`Blog · ${label}`} description={`Artículos de Sergio Chala sobre ${label}.`} wide>
  <BlogListing
    heading={`Blog · ${label}`}
    posts={posts}
    activePillar={pilar}
  />
</Layout>
