---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { author } from '../../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);

const pillarLabels: Record<string, string> = {
  hotmart: 'Hotmart',
  skool: 'Skool',
  claude: 'Claude',
};

const pillarLabel = pillarLabels[post.data.pillar];
const postUrl = new URL(`/blog/${post.id}/`, Astro.site).toString();
const pillarUrl = new URL(`/blog/${post.data.pillar}/`, Astro.site).toString();
const blogUrl = new URL('/blog/', Astro.site).toString();
const homeUrl = new URL('/', Astro.site).toString();

const shareText = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(postUrl);
const shareLinks = {
  whatsapp: `https://wa.me/?text=${shareText}%20${shareUrl}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`,
  x: `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
};

const dateFmt = (d: Date) =>
  d.toLocaleDateString('es', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author.name,
  },
  mainEntityOfPage: postUrl,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
    { '@type': 'ListItem', position: 3, name: pillarLabel, item: pillarUrl },
    { '@type': 'ListItem', position: 4, name: post.data.title, item: postUrl },
  ],
};

const faqJsonLd = post.data.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---
<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.coverImage}
  wide
  progress
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <nav class="breadcrumbs" aria-label="Migas de pan">
    <a href="/">Inicio</a> › <a href="/blog/">Blog</a> › <a href={`/blog/${post.data.pillar}/`}>{pillarLabel}</a>
  </nav>

  <section class="post-hero full-bleed">
    <div class="post-hero-inner">
      <div class="post-hero-media" data-pillar={post.data.pillar}>
        {post.data.coverImage ? (
          <img src={post.data.coverImage} alt={post.data.title} width="560" height="350" />
        ) : (
          <span>{pillarLabel}</span>
        )}
      </div>
      <div class="post-hero-copy">
        <span class="pillar-tag">{pillarLabel}</span>
        <h1>{post.data.title}</h1>
        <p class="post-hero-desc">{post.data.description}</p>
        <div class="post-author">
          {author.avatar ? (
            <img class="post-author-avatar post-author-avatar-img" src={author.avatar} alt={author.name} width="40" height="40" />
          ) : (
            <div class="post-author-avatar">SC</div>
          )}
          <div class="post-author-meta">
            <strong>{author.name}</strong>
            <span>
              {dateFmt(post.data.pubDate)}
              {post.data.updatedDate && <> · Actualizado el {dateFmt(post.data.updatedDate)}</>}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="post-layout">
    {toc.length > 0 && (
      <aside class="post-toc">
        <p class="post-toc-label">En este artículo</p>
        <ul>
          {toc.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ul>
      </aside>
    )}

    <article class="post post-main">
      <Content />

      {post.data.faq.length > 0 && (
        <section class="faq">
          <h2>Preguntas frecuentes</h2>
          {post.data.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </section>
      )}

      {post.data.sources.length > 0 && (
        <section class="sources">
          <h2>Fuentes consultadas</h2>
          <ul>
            {post.data.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer nofollow">{source.label}</a>
              </li>
            ))}
          </ul>
          {post.data.verifiedDate && (
            <p class="post-meta">
              Datos verificados el {dateFmt(post.data.verifiedDate)}
            </p>
          )}
        </section>
      )}

      <div class="post-share">
        <p class="post-share-label">¿Te sirvió este artículo? Compártelo:</p>
        <div class="post-share-buttons">
          <a class="post-share-btn post-share-btn--whatsapp" href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Compartir en WhatsApp">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.74.46 3.43 1.33 4.93L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.79 14.07c-.24.68-1.41 1.3-1.95 1.38-.5.08-1.12.11-1.81-.11-.42-.13-.95-.31-1.64-.6-2.88-1.24-4.76-4.15-4.9-4.34-.14-.19-1.17-1.56-1.17-2.98 0-1.42.74-2.11 1-2.4.26-.29.58-.36.77-.36h.55c.18 0 .42-.07.65.5.24.58.82 2 .89 2.15.07.15.12.32.02.51-.1.19-.15.31-.3.48-.15.17-.31.37-.44.5-.15.15-.3.31-.13.6.17.3.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.37 1.47.29.15.46.13.63-.08.17-.2.72-.84.91-1.13.19-.29.38-.24.64-.14.26.1 1.65.78 1.94.92.29.14.48.21.55.33.07.12.07.68-.17 1.36z"/>
            </svg>
          </a>
          <a class="post-share-btn post-share-btn--facebook" href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Compartir en Facebook">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M14 9h2.5V6H14c-2.21 0-4 1.79-4 4v1.3H8v3h2v6.7h3v-6.7h2.4l.4-3H13V10c0-.55.45-1 1-1z"/>
            </svg>
          </a>
          <a class="post-share-btn post-share-btn--x" href={shareLinks.x} target="_blank" rel="noopener noreferrer" aria-label="Compartir en X">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M3 3l7.5 9.5L3.5 21H6l6-6.8L17 21h4l-7.8-9.9L20.5 3H18l-5.5 6.2L8 3H3z"/>
            </svg>
          </a>
          <a class="post-share-btn post-share-btn--linkedin" href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Compartir en LinkedIn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M6.94 8.5H4V20h2.94V8.5zM5.47 4a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4zM20 13.3c0-3-1.6-4.4-3.8-4.4-1.75 0-2.53.96-2.96 1.64V8.5H10.3c.04.85 0 11.5 0 11.5h2.94v-6.42c0-.34.02-.69.13-.93.28-.69.92-1.41 2-1.41 1.41 0 1.97 1.07 1.97 2.64V20H20v-6.7z"/>
            </svg>
          </a>
          <button type="button" class="post-share-btn post-share-btn--copy" id="post-share-copy" data-url={postUrl} aria-label="Copiar enlace">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M9.5 14.5l5-5" stroke-linecap="round" />
              <path d="M12.5 7.5l1.2-1.2a3 3 0 1 1 4.2 4.2L16.7 11.7" stroke-linecap="round" />
              <path d="M11.5 16.5l-1.2 1.2a3 3 0 1 1-4.2-4.2L7.3 12.3" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        <p class="post-share-copied" id="post-share-copied" hidden>¡Enlace copiado!</p>
      </div>
    </article>

    <aside class="post-sidebar">
      <div class="post-ad-card">
        <p class="post-ad-eyebrow">Aprende más</p>
        <h3>Crea tu comunidad en Skool</h3>
        <p>Si quieres aprender a montar y monetizar tu propia comunidad, te enseño paso a paso dentro del curso.</p>
        <a
          class="cta cta-accent cta-pulse"
          href="https://www.skool.com/infocreators-club-pro-6633/about"
          target="_blank"
          rel="noopener noreferrer"
        >
          Toma mi Curso
        </a>
      </div>
    </aside>
  </div>

  <script>
    document.querySelectorAll<HTMLAnchorElement>('.post a[href]').forEach((link) => {
      link.setAttribute('target', '_blank');
      const rel = new Set((link.getAttribute('rel') ?? '').split(/\s+/).filter(Boolean));
      rel.add('noopener');
      rel.add('noreferrer');
      link.setAttribute('rel', [...rel].join(' '));
    });

    const copyBtn = document.getElementById('post-share-copy');
    const copiedMsg = document.getElementById('post-share-copied');
    copyBtn?.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
      }
      if (copiedMsg) {
        copiedMsg.hidden = false;
        window.setTimeout(() => {
          copiedMsg.hidden = true;
        }, 2000);
      }
    });
  </script>
</Layout>
