---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);

const pillarLabels: Record<string, string> = {
  hotmart: 'Hotmart',
  skool: 'Skool',
  claude: 'Claude',
};

const pillarLabel = pillarLabels[post.data.pillar];
const postUrl = new URL(`/blog/${post.id}/`, Astro.site).toString();
const pillarUrl = new URL(`/blog/${post.data.pillar}/`, Astro.site).toString();
const blogUrl = new URL('/blog/', Astro.site).toString();
const homeUrl = new URL('/', Astro.site).toString();

const dateFmt = (d: Date) =>
  d.toLocaleDateString('es', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Sergio Chala',
  },
  mainEntityOfPage: postUrl,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
    { '@type': 'ListItem', position: 3, name: pillarLabel, item: pillarUrl },
    { '@type': 'ListItem', position: 4, name: post.data.title, item: postUrl },
  ],
};

const faqJsonLd = post.data.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---
<Layout title={post.data.title} description={post.data.description} wide progress>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <nav class="breadcrumbs" aria-label="Migas de pan">
    <a href="/">Inicio</a> › <a href="/blog/">Blog</a> › <a href={`/blog/${post.data.pillar}/`}>{pillarLabel}</a>
  </nav>

  <section class="post-hero full-bleed">
    <div class="post-hero-inner">
      <div class="post-hero-media" data-pillar={post.data.pillar}>
        <span>{pillarLabel}</span>
      </div>
      <div class="post-hero-copy">
        <span class="pillar-tag">{pillarLabel}</span>
        <h1>{post.data.title}</h1>
        <p class="post-hero-desc">{post.data.description}</p>
        <div class="post-author">
          <div class="post-author-avatar">SC</div>
          <div class="post-author-meta">
            <strong>Sergio Chala</strong>
            <span>
              {dateFmt(post.data.pubDate)}
              {post.data.updatedDate && <> · Actualizado el {dateFmt(post.data.updatedDate)}</>}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="post-layout">
    {toc.length > 0 && (
      <aside class="post-toc">
        <p class="post-toc-label">En este artículo</p>
        <ul>
          {toc.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ul>
      </aside>
    )}

    <article class="post post-main">
      <Content />

      {post.data.faq.length > 0 && (
        <section class="faq">
          <h2>Preguntas frecuentes</h2>
          {post.data.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </section>
      )}

      {post.data.sources.length > 0 && (
        <section class="sources">
          <h2>Fuentes consultadas</h2>
          <ul>
            {post.data.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer nofollow">{source.label}</a>
              </li>
            ))}
          </ul>
          {post.data.verifiedDate && (
            <p class="post-meta">
              Datos verificados el {dateFmt(post.data.verifiedDate)}
            </p>
          )}
        </section>
      )}
    </article>

    <aside class="post-sidebar">
      <div class="post-ad-card">
        <p class="post-ad-eyebrow">Aprende más</p>
        <h3>Crea tu comunidad en Skool</h3>
        <p>Si quieres aprender a montar y monetizar tu propia comunidad, te enseño paso a paso dentro del curso.</p>
        <a
          class="cta cta-accent cta-pulse"
          href="https://www.skool.com/infocreators-club-pro-6633/about"
          target="_blank"
          rel="noopener noreferrer"
        >
          Toma mi Curso
        </a>
      </div>
    </aside>
  </div>
</Layout>
