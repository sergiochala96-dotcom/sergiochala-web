---
import Layout from '../layouts/Layout.astro';
import NewsletterSection from '../components/NewsletterSection.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const pillarLabels: Record<string, string> = {
  hotmart: 'Hotmart',
  skool: 'Skool',
  claude: 'Claude',
};

const dateFmt = (d: Date) =>
  d.toLocaleDateString('es', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Layout title="Sergio Chala" description="Te ayudo a construir tu negocio digital — comunidad, cursos y automatización con IA — con lo que a mí me ha funcionado de verdad." darkHero>
  <section class="hero-dark full-bleed">
    <div class="full-bleed-inner hero-dark-inner">
      <div class="hero-copy">
        <h1>Construye tu negocio digital y monetiza lo que sabes, con IA.</h1>
        <p class="hero-sub">
          Te acompaño a crear tu propio ecosistema digital: comunidad, cursos e infoproductos,
          y a automatizarlo con inteligencia artificial. Con lo que a mí me ha funcionado de
          verdad, sin humo ni promesas de resultados garantizados.
        </p>
        <div class="hero-actions">
          <a class="cta cta-glass cta-pulse-glass" href="/blog/">Ver el blog</a>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">+6 años</span>
            <span class="stat-label">construyendo comunidades y negocios digitales</span>
          </div>
          <div class="stat">
            <span class="stat-number">+4.650</span>
            <span class="stat-label">ventas en internet</span>
          </div>
          <div class="stat">
            <span class="stat-number">+250.000</span>
            <span class="stat-label">dólares facturados</span>
          </div>
        </div>
      </div>

      <div class="hero-photo">
        <img src="/images/sergio-hero-cutout.png" alt="Sergio Chala" width="1254" height="1254" />
      </div>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="section-latest-blog">
      <h2>Últimos Blogs de Sergio...</h2>
      <p class="section-sub">Lo más reciente sobre Skool, Hotmart y Claude.</p>
      <div class="latest-blog-grid">
        {latestPosts.map((post) => (
          <a class="blog-card" href={`/blog/${post.id}/`}>
            <div class="blog-card-media" data-pillar={post.data.pillar}>
              {post.data.coverImage ? (
                <img src={post.data.coverImage} alt={post.data.title} width="400" height="250" />
              ) : (
                <span>{pillarLabels[post.data.pillar]}</span>
              )}
            </div>
            <p class="post-meta">
              {dateFmt(post.data.pubDate)} · <span class="pillar-tag">{pillarLabels[post.data.pillar]}</span>
            </p>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
      <div class="latest-blog-cta">
        <a class="cta cta-accent" href="/blog/">Ir al blog →</a>
      </div>
    </section>
  )}

  <section class="section-youtube">
    <div class="youtube-card">
      <p class="youtube-watermark" aria-hidden="true">SERGIO CHALA</p>
      <div class="youtube-card-copy">
        <a class="youtube-go-link" href="https://www.youtube.com/@sergiochalav/featured?sub_confirmation=1" target="_blank" rel="noopener noreferrer">Ir al canal →</a>
        <h2>YouTube</h2>
        <p class="youtube-channel-name">Sergio Chala</p>
        <a class="youtube-play" href="https://www.youtube.com/@sergiochalav/featured?sub_confirmation=1" target="_blank" rel="noopener noreferrer" aria-label="Ir al canal de YouTube">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
            <path d="M8 6.5L18 12L8 17.5V6.5Z" fill="currentColor" />
          </svg>
        </a>
      </div>
    </div>
    <div class="youtube-section-footer">
      <p>
        Videos sobre comunidades digitales, infoproductos e inteligencia artificial: todo lo que voy
        aprendiendo construyendo mi propio negocio online.
      </p>
      <a class="youtube-cta-pill" href="https://www.youtube.com/@sergiochalav/featured?sub_confirmation=1" target="_blank" rel="noopener noreferrer">Suscríbete <span>→</span></a>
    </div>
  </section>

  <section class="cta-band full-bleed">
    <div class="full-bleed-inner cta-band-inner">
      <h2>¿Empezamos?</h2>
      <p>Te dejo todo lo que voy aprendiendo en el blog, con capturas de mis propias cuentas.</p>
      <a class="cta cta-accent" href="/blog/">Leer el blog</a>
    </div>
  </section>

  <section class="section-faq">
    <h2>Preguntas frecuentes</h2>
    <div class="faq">
      <details>
        <summary>¿Quién es Sergio Chala?</summary>
        <p>Llevo años trabajando en negocios digitales, comunidades online y creación de contenido. Este sitio es mi marca personal, separada de mis otros proyectos.</p>
      </details>
      <details>
        <summary>¿Qué voy a encontrar en este blog?</summary>
        <p>Artículos sobre Skool, Hotmart y Claude basados en lo que yo mismo hago y he vivido, con tutoriales paso a paso y capturas reales.</p>
      </details>
      <details>
        <summary>¿Vendes cursos o mentorías?</summary>
        <p>Esta sección está en construcción — por ahora el foco es el blog. Pronto voy a contar aquí qué más ofrezco.</p>
      </details>
      <details>
        <summary>¿Por qué confiar en tu experiencia?</summary>
        <p>Porque todo lo que cuento lo hago yo mismo primero, en mis propias comunidades y productos, antes de escribir sobre ello.</p>
      </details>
    </div>
  </section>

  <NewsletterSection />
</Layout>
