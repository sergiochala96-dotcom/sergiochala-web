---
import Layout from '../../layouts/Layout.astro';
import NewsletterSection from '../../components/NewsletterSection.astro';

type Category = 'servicios' | 'comunidades';

interface Offer {
  category: Category;
  icon: string;
  bannerImage?: string;
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  external?: boolean;
}

const icons: Record<string, string> = {
  megaphone:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10v4a1 1 0 0 0 1 1h2l3.5 4.5a1 1 0 0 0 1.8-.6V5.1a1 1 0 0 0-1.8-.6L6 9H4a1 1 0 0 0-1 1Z"/><path d="M15 9.5a3.5 3.5 0 0 1 0 5"/><path d="M18 7a7 7 0 0 1 0 10"/></svg>',
  compass:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-6 2 2-6 6-2Z"/></svg>',
  rocket:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 16s-1 3 0 4c1 1 4 0 4 0"/><path d="M12.5 4.5c3 0 6 3 6 6.5 0 4-3.5 7-5.5 8l-3-3c1-2 4-5.5 4-9 0-1-.2-1.8-1.5-2.5Z"/><path d="M9 14c-2 0-4-1-4-1s2.5-4 4.5-4.5"/><circle cx="14" cy="10" r="1"/></svg>',
  users:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="8.5" r="2.3"/><path d="M15.5 14.3c2.5.4 4.5 2.6 4.5 5.7"/></svg>',
  flag:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3v18"/><path d="M5 4h11l-2.5 3.5L16 11H5"/></svg>',
  person:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"/></svg>',
};

const servicios: Offer[] = [
  {
    category: 'servicios',
    icon: 'megaphone',
    bannerImage: '/images/servicio-manejo-pauta-publicitaria-banner.jpg',
    title: 'Manejo de Pauta Publicitaria',
    description:
      'Me encargo de la configuración, el seguimiento y la optimización de tus anuncios, para que tu inversión en pauta trabaje para tu infonegocio y no al revés.',
    ctaLabel: 'Escríbeme por este servicio',
    ctaHref: '/contacto/',
  },
  {
    category: 'servicios',
    icon: 'compass',
    bannerImage: '/images/servicio-asesoria-estrategica-marketing-banner.jpg',
    title: 'Asesoría Estratégica de Marketing',
    description:
      'Revisamos juntos tu oferta, tu comunidad y tus canales de venta, y armamos un plan concreto con las prioridades reales de tu negocio digital.',
    ctaLabel: 'Escríbeme por este servicio',
    ctaHref: '/contacto/',
  },
  {
    category: 'servicios',
    icon: 'rocket',
    bannerImage: '/images/servicio-lanzamientos-digitales-banner.jpg',
    title: 'Lanzamientos Digitales de Infoproductos',
    description:
      'Te acompaño en la planeación y ejecución del lanzamiento de tu infoproducto: cronograma, comunicación con tu audiencia y lo que he aprendido lanzando los míos.',
    ctaLabel: 'Escríbeme por este servicio',
    ctaHref: '/contacto/',
  },
];

const comunidades: Offer[] = [
  {
    category: 'comunidades',
    icon: 'users',
    bannerImage: '/images/comunidad-infocreators-club-banner.jpg',
    title: 'Infocreators Club',
    description:
      'La comunidad donde acompaño paso a paso a quienes quieren construir y monetizar su propio infonegocio con Skool, Hotmart e inteligencia artificial.',
    ctaLabel: 'Ver la comunidad',
    ctaHref: 'https://www.skool.com/infocreators-club-pro-6633/about',
    external: true,
  },
  {
    category: 'comunidades',
    icon: 'flag',
    bannerImage: '/images/comunidad-reto-skool-banner.jpg',
    title: 'Reto Skool',
    description:
      'Un espacio para quienes están dando sus primeros pasos en comunidades digitales y quieren aprender junto a otros creadores.',
    ctaLabel: 'Ver la comunidad',
    ctaHref: 'https://www.skool.com/the-creators-community-4018/about',
    external: true,
  },
  {
    category: 'comunidades',
    icon: 'person',
    bannerImage: '/images/mentoria-1a1-infoproductores-banner.jpg',
    title: 'Mentoría 1 a 1 para Infoproductores',
    description:
      'Sesiones de mentoría individual para revisar tu negocio digital y avanzar más rápido, con lo que he aprendido construyendo el mío.',
    ctaLabel: 'Escríbeme por esta mentoría',
    ctaHref: '/contacto/',
  },
];
---
<Layout
  title="Servicios"
  description="Servicios de marketing para infonegocios y comunidades digitales de Sergio Chala: pauta publicitaria, asesoría estratégica, lanzamientos y mentoría."
  wide
>
  <section class="offers-hero">
    <span class="offers-eyebrow">Servicios y comunidades</span>
    <h1>Servicios &amp; Comunidades</h1>
    <p>
      Esto es lo que ofrezco además del blog: servicios de marketing para infonegocios,
      y mis comunidades y mentorías para quienes quieren construir el suyo acompañados.
    </p>
  </section>

  <section class="offers-block">
    <h2 class="offers-block-title">Servicios</h2>
    <div class="offers-grid">
      {servicios.map((offer) => (
        <div class="offer-card">
          <div class={`offer-card-banner offer-card-banner--${offer.category}`}>
            {offer.bannerImage ? (
              <img src={offer.bannerImage} alt={offer.title} width="960" height="540" />
            ) : (
              <span class="offer-card-banner-icon" set:html={icons[offer.icon]} />
            )}
          </div>
          <div class="offer-card-body">
            <div class="offer-card-head">
              <span class="offer-card-icon" set:html={icons[offer.icon]} />
              <h3>{offer.title}</h3>
            </div>
            <p class="offer-description">{offer.description}</p>
            <div class="offer-card-footer">
              <a
                class="cta cta-accent offer-cta"
                href={offer.ctaHref}
                target={offer.external ? '_blank' : undefined}
                rel={offer.external ? 'noopener noreferrer' : undefined}
              >
                {offer.ctaLabel}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="offers-block">
    <h2 class="offers-block-title">Mis comunidades</h2>
    <div class="offers-grid">
      {comunidades.map((offer) => (
        <div class="offer-card">
          <div class={`offer-card-banner offer-card-banner--${offer.category}`}>
            {offer.bannerImage ? (
              <img src={offer.bannerImage} alt={offer.title} width="960" height="540" />
            ) : (
              <span class="offer-card-banner-icon" set:html={icons[offer.icon]} />
            )}
          </div>
          <div class="offer-card-body">
            <div class="offer-card-head">
              <span class="offer-card-icon" set:html={icons[offer.icon]} />
              <h3>{offer.title}</h3>
            </div>
            <p class="offer-description">{offer.description}</p>
            <div class="offer-card-footer">
              <a
                class="cta cta-accent offer-cta"
                href={offer.ctaHref}
                target={offer.external ? '_blank' : undefined}
                rel={offer.external ? 'noopener noreferrer' : undefined}
              >
                {offer.ctaLabel}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="offers-disclaimer">
      Sergio Chala no es empleado ni representante de Skool — Infocreators Club y Reto Skool son
      comunidades propias administradas por él en esa plataforma.
    </p>
  </section>

  <NewsletterSection />
</Layout>
