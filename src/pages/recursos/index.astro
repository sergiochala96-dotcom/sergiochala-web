---
import Layout from '../../layouts/Layout.astro';
import NewsletterSection from '../../components/NewsletterSection.astro';

const resources = [
  {
    icon: '/images/recurso-icono-kit-lanzar-comunidad-skool.png',
    title: '[KIT] Plantilla para lanzar tu comunidad en Skool',
    text: 'Una guía paso a paso para ordenar el lanzamiento de tu comunidad antes de abrirla al público.',
    cta: 'Obtener gratis',
    href: '#',
  },
  {
    icon: '/images/recurso-icono-skooly.png',
    title: 'Skooly: crea y lanza tu skool en 7 días',
    text: 'Mi aplicación para crear y lanzar tu comunidad en Skool paso a paso, en solo 7 días.',
    cta: 'Probar Skooly',
    href: 'https://skool.neobrandclub.com/',
  },
  {
    icon: '/images/recurso-icono-calculadora-ganancias-skool.png',
    title: 'Calculadora de ganancias de Skool',
    text: 'Calcula cuánto podrías ganar con tu comunidad en Skool según el precio y la cantidad de miembros.',
    cta: 'Abrir calculadora',
    href: 'https://tally.so/r/J9Z9Zd',
  },
  {
    icon: '/images/recurso-icono-mentoria-1a1.png',
    title: 'Mentoría 1 a 1 para Infoproductores',
    text: 'Acompañamiento personalizado para montar o escalar tu ecosistema digital.',
    cta: 'Escríbeme por esta mentoría',
    href: 'https://api.whatsapp.com/send?phone=573015144829&text=Hola%20Sergio,%20Me%20interesar%C3%ADa%20saber%20m%C3%A1s%20sobre%20tu%20Mentor%C3%ADa%20Personalizada%201a1%20para%20Infoproductores,%20mi%20nombres%20es:%20',
  },
];
---
<Layout title="Recursos Gratuitos" description="Recursos 100% gratuitos de Sergio Chala: plantillas, Skooly, calculadora de ganancias de Skool y mentoría." wide>
  <section class="resources-hero">
    <h1>Recursos 100% Gratuitos</h1>
  </section>

  <section class="resources-section">
    <aside class="resources-author">
      <img class="resources-author-photo" src="/images/sergio-avatar.jpg" alt="Sergio Chala" width="160" height="160" />
      <h2>Sergio Chala</h2>
      <p class="resources-author-role">AI CEO · Mentor y consultor en negocios digitales</p>
      <div class="resources-author-social">
        <a href="https://www.instagram.com/sergiochala/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.8" />
            <circle cx="12" cy="12" r="4.3" stroke="currentColor" stroke-width="1.8" />
            <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" />
          </svg>
        </a>
        <a href="https://www.youtube.com/@sergiochalav/featured?sub_confirmation=1" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <rect x="2" y="5.5" width="20" height="13" rx="4" stroke="currentColor" stroke-width="1.8" />
            <path d="M10.5 9.3L15 12L10.5 14.7V9.3Z" fill="currentColor" />
          </svg>
        </a>
        <a href="https://www.skool.com/infocreators-club-pro-6633/about" target="_blank" rel="noopener noreferrer" aria-label="Skool">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.8" />
            <path d="M12 7.2C9.9 7.2 8.3 8.2 8.3 9.6C8.3 12.6 15.7 11.1 15.7 14.3C15.7 15.8 14 16.8 12 16.8C10 16.8 8.3 15.9 8.3 14.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </a>
      </div>
    </aside>

    <div class="resources-grid">
      <div class="resources-cards">
        {resources.map((item) => (
          <div class="resource-card">
            <img class="resource-card-icon" src={item.icon} alt="" width="72" height="72" loading="lazy" />
            <div class="resource-card-body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a class="cta" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{item.cta}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>
